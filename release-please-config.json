{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "versioning": "prerelease",
      "prerelease-type": "rc1",
      "prerelease": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "refactor",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        },
        {
          "type": "style",
          "hidden": true
        },
        {
          "type": "build",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='decktalk')].version"
        },
        {
          "type": "generic",
          "path": "src/decktalk/runtime/src/index.ts"
        },
        {
          "type": "generic",
          "path": "README.md"
        }
      ],
      "exclude-paths": [
        ".github",
        "assets",
        "docs",
        "scripts",
        "site",
        "tests"
      ]
    }
  }
}
