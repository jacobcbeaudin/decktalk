# Copy to .env in your project directory (git-ignored). Never commit the real key.
# ELEVENLABS_API_KEY is the one credential a voiced run needs, for `decktalk narrate` and
# `decktalk soundscape`. ELEVENLABS_VOICE_ID is a published name rather than a secret, and it is
# part of what names a take, so changing it re-voices every section.
ELEVENLABS_API_KEY=<your-elevenlabs-key>
ELEVENLABS_VOICE_ID=<voice-id>
