# Makes the film section 4 of the motion example plays in its pane.
#
# DeckTalk runs this as the command of the example's [[clip]] the first time a build records:
#
#     {python} render/make_film {out} {landings} {ffmpeg} {fps}
#
# A package ships no video, so the film is made here from ffmpeg's own sources: three seconds of
# 640 by 360 in the deck's colours, a bar sweeping its top strip a width a second so it moves from
# its first frame, a ground that cuts from ink to the accent and then to white a second apart, and a
# steady tone, well under the narration, which DeckTalk matches to the voice's loudness. It is made
# at the film's rate, so every frame of it is one frame of the pane.
#
# It also writes the film's own landings, the two cuts, measured on the lower part of the frame the
# bar never crosses, in the shape a page reports its motions, so `decktalk verify` measures each cut
# on the film's clock from the cue the pane starts on.

import json
import subprocess
import sys

WIDTH, HEIGHT, SECONDS = 640, 360, 3
BAR_W, BAR_H = 160, 60  # the bar that sweeps the top strip
INK, ACCENT, PAPER = "0x0f0f12", "0x2c1fea", "0xffffff"  # the deck's own colours
TONE_HZ, TONE_DB = 660, -10


def main() -> None:
    out, landings, ffmpeg, fps = sys.argv[1:5]
    sweep = f"mod(t*W,W-{BAR_W})"
    graph = (
        f"color=c={INK}:s={WIDTH}x{HEIGHT}:r={fps}:d={SECONDS},"
        f"drawbox=x=0:y=0:w={WIDTH}:h={HEIGHT}:color={ACCENT}:t=fill:enable='between(t,1,2)',"
        f"drawbox=x=0:y=0:w={WIDTH}:h={HEIGHT}:color={PAPER}:t=fill:enable='gte(t,2)'[ground];"
        f"color=c={PAPER}:s={BAR_W}x{BAR_H}:r={fps}:d={SECONDS},drawbox=t=4:color={INK}[bar];"
        f"[ground][bar]overlay=x='{sweep}':y=20:eval=frame:shortest=1[v];"
        f"sine=frequency={TONE_HZ}:sample_rate=48000:duration={SECONDS},volume={TONE_DB}dB[a]"
    )
    subprocess.run(
        [ffmpeg, "-y", "-loglevel", "error", "-filter_complex", graph, "-map", "[v]", "-map", "[a]",
         "-c:v", "libx264", "-crf", "12", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "192k", out],
        check=True,
    )
    lower = {"x": 0, "y": 120, "w": WIDTH, "h": HEIGHT - 120}
    with open(landings, "w", encoding="utf-8") as written:
        json.dump([{
            "id": "cuts",
            "kind": "motion",
            "box": lower,
            "size": {"w": lower["w"], "h": lower["h"]},
            "departs": 1.0,
            "arrives": 2.0,
            "landings": [{"cue": "accent", "kind": "depart", "at": 1.0}, {"cue": "paper", "kind": "depart", "at": 2.0}],
        }], written, indent=1)


main()
