# Copy to .env in your project directory (git-ignored). Never commit the real key.
# ELEVENLABS_API_KEY is the one credential a voiced run needs, and both voices are bought with it.
# The voices themselves are `[voices.narrator] id` and `[voices.guest] id` in decktalk.toml,
# published names rather than secrets, so they are committed with the project.
ELEVENLABS_API_KEY=<your-elevenlabs-key>
