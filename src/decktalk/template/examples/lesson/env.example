# Copy to .env in your project directory (git-ignored). Never commit the real key.
# ELEVENLABS_API_KEY is the one credential a voiced run needs, for `decktalk narrate` and
# `decktalk score`. The voice itself is `[voice] id` in decktalk.toml, a published name
# rather than a secret, so it is committed with the project.
ELEVENLABS_API_KEY=<your-elevenlabs-key>
