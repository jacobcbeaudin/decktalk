# Makes the film the pane plays by building the DeckTalk project in film/ with no voice, and copies the
# built film, its landings and its words to where the [[clip]] asks for them.
#
#     {python} deck/make_film {out} {landings} {words}
#
# The build runs with a machine file that is not there, so it reads no settings of the machine running it. It
# finds film/ beside its own file, because a program runs in a scratch folder rather than in the project.

import os
import shutil
import subprocess
import sys
from pathlib import Path

out, landings, words = sys.argv[1:4]
film = Path(__file__).resolve().parent.parent / "film"
environ = {**os.environ, "DECKTALK_MACHINE_FILE": str(film.resolve() / "no-machine.toml")}
subprocess.run([sys.executable, "-m", "decktalk", "--project", str(film), "build", "--no-spend"], check=True,
               env=environ, stdout=subprocess.DEVNULL)
final = film / "build" / "final"
shutil.copyfile(final / "film.mp4", out)
shutil.copyfile(final / "film.landings.json", landings)
shutil.copyfile(final / "film.words.json", words)
