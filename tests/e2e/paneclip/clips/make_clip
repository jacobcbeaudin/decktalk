# Makes the clip the pane plays: three seconds of 640 by 360, red, then green, then blue, a second
# each, with a white square sweeping its top strip a width a second, and a steady 1 kHz tone well
# under the narration's loudness. It also writes the clip's own landings, the two colour changes, measured
# on the lower part of the frame the square never crosses.
#
#     {python} clips/make_clip {out} {landings} {ffmpeg} {fps}

import json
import subprocess
import sys

WIDTH, HEIGHT, SECONDS = 640, 360, 3
SQUARE = 80
TONE_DB = -10

out, landings, ffmpeg, fps = sys.argv[1:5]
travel = f"mod(t*W,W-{SQUARE})"
graph = (
    f"color=c=red:s={WIDTH}x{HEIGHT}:r={fps}:d={SECONDS}[ground];"
    f"[ground]drawbox=x=0:y=0:w={WIDTH}:h={HEIGHT}:color=green:t=fill:enable='between(t,1,2)',"
    f"drawbox=x=0:y=0:w={WIDTH}:h={HEIGHT}:color=blue:t=fill:enable='gte(t,2)'[colour];"
    f"color=c=white:s={SQUARE}x{SQUARE}:r={fps}:d={SECONDS}[square];"
    f"[colour][square]overlay=x='{travel}':y=0:eval=frame:shortest=1[v];"
    f"sine=frequency=1000:sample_rate=48000:duration={SECONDS},volume={TONE_DB}dB[a]"
)
subprocess.run(
    [ffmpeg, "-y", "-loglevel", "error", "-filter_complex", graph, "-map", "[v]", "-map", "[a]", "-c:v", "libx264", "-crf", "12", "-pix_fmt", "yuv420p",
     "-c:a", "aac", "-b:a", "192k", out],
    check=True,
)
lower = {"x": 0, "y": SQUARE + 40, "w": WIDTH, "h": HEIGHT - SQUARE - 40}
with open(landings, "w", encoding="utf-8") as written:
    json.dump([{
        "id": "colour",
        "kind": "motion",
        "box": lower,
        "size": {"w": lower["w"], "h": lower["h"]},
        "departs": 1.0,
        "arrives": 2.0,
        "landings": [{"cue": "green", "kind": "depart", "at": 1.0}, {"cue": "blue", "kind": "depart", "at": 2.0}],
    }], written, indent=1)
