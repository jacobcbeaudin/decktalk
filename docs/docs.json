      },
      {
        "group": "Agents",
        "pages": [
          "agents/skills",
          "agents/install",
          "agents/agents-md",
          "agents/json",
          "reference/card"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/troubleshooting",
          "help/faq",
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "decktalk.ai",
        "href": "https://decktalk.ai"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/jacobcbeaudin/decktalk"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jacobcbeaudin/decktalk",
      "website": "https://decktalk.ai"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "DeckTalk",
      "twitter:card": "summary_large_image"
    }
  },
  "redirects": [
    {
      "source": "/concepts/pipeline",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/concepts/project-file",
      "destination": "/reference/decktalk-toml"
    },
    {
      "source": "/reference/settings/:key*",
      "destination": "/reference/configuration"
    }
  ]
}
