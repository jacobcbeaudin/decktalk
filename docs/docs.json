              "reference/findings/PAGE_TRUNCATED",
              "reference/findings/PAGE_CDN_ASSET",
              "reference/findings/CUE_MISSING",
              "reference/findings/CUE_UNKNOWN",
              "reference/findings/CUE_UNRESOLVED",
              "reference/findings/CUE_OFF",
              "reference/findings/CUE_NO_ONSET",
              "reference/findings/CUE_NO_CHANGE",
              "reference/findings/CUE_THIN_CHANGE",
              "reference/findings/CUE_OVERLAP",
              "reference/findings/TAKE_PLACEHOLDER",
