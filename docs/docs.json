{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DeckTalk",
  "description": "Narrated presentations, cut to the word.",
  "colors": {
    "primary": "#2c1fea",
    "light": "#7c8cff",
    "dark": "#2c1fea"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://decktalk.app"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Inter Tight"
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "system"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "guides/first-deck"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/writing-for-the-ear",
          "guides/slide-recipes",
          "guides/clip-section",
          "guides/sfx-on-a-cue",
          "guides/rebuild-one-section",
          "guides/ci-and-offline",
          "guides/page-by-hand"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/how-it-works",
          "concepts/cues",
          "concepts/page-contract",
          "concepts/sound"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/card",
          "reference/decktalk-toml",
          "reference/script-md",
          "reference/cues-json",
          "reference/runtime",
          "reference/cli",
          "reference/configuration",
          "reference/artifacts",
          "reference/python-api"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/troubleshooting",
          "help/faq",
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "PyPI",
        "href": "https://pypi.org/project/decktalk/",
        "icon": "python"
      },
      {
        "label": "Changelog",
        "href": "/changelog",
        "icon": "list"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/jacobcbeaudin/decktalk"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jacobcbeaudin/decktalk",
      "website": "https://decktalk.app"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "DeckTalk",
      "og:description": "DeckTalk turns a markdown script, plain HTML slides, and an ElevenLabs voice into one narrated video in which every reveal lands on the word that introduces it."
    }
  },
  "redirects": [
    {
      "source": "/concepts/pipeline",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/concepts/project-file",
      "destination": "/reference/decktalk-toml"
    }
  ]
}
