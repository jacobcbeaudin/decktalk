{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "DeckTalk",
  "description": "Narrated presentations, cut to the word.",
  "colors": {
    "primary": "#2c1fea",
    "light": "#7c8cff",
    "dark": "#5b50f5"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0e0e0f"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "eyebrows": "section",
    "latex": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "requirements",
          "guides/first-deck"
        ]
      },
      {
        "group": "Use cases",
        "pages": [
          "use-cases/technical-tutorials",
          "use-cases/product-demos",
          "use-cases/lessons"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/how-it-works",
          "concepts/cues",
          "concepts/page-contract",
          "concepts/sound"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/writing-for-the-ear",
          "guides/design-a-slide",
          "guides/slide-recipes",
          "guides/rebuild-one-section",
          "guides/clip-section",
          "guides/sfx-on-a-cue",
          "guides/accessible-video",
          "guides/ci-and-offline",
          "guides/page-by-hand"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/verify",
          "reference/script-md",
          "reference/decktalk-toml",
          "reference/cues-json",
          "reference/runtime",
          "reference/configuration",
          "reference/artifacts",
          "reference/what-leaves-your-machine",
          "reference/python-api",
          "reference/glossary"
        ]
      },
      {
        "group": "Agents",
        "pages": [
          "agents/skills",
          "agents/install",
          "agents/agents-md",
          "agents/json",
          "reference/card"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/troubleshooting",
          "help/faq",
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "decktalk.ai",
        "href": "https://decktalk.ai"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/jacobcbeaudin/decktalk"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jacobcbeaudin/decktalk",
      "website": "https://decktalk.ai"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "DeckTalk",
      "twitter:card": "summary_large_image"
    }
  },
  "redirects": [
    {
      "source": "/concepts/pipeline",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/concepts/project-file",
      "destination": "/reference/decktalk-toml"
    }
  ]
}
