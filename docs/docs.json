{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "DeckTalk",
  "description": "Narrated presentations, cut to the word.",
  "colors": {
    "primary": "#7a5000",
    "light": "#f2b441",
    "dark": "#7a5000"
  },
  "background": {
    "color": {
      "light": "#fbf7f1",
      "dark": "#15110e"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Instrument Serif",
      "weight": 400
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "eyebrows": "section",
    "latex": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "guides/first-deck",
          "requirements",
          "examples"
        ]
      },
      {
        "group": "Use cases",
        "pages": [
          "use-cases/technical-tutorials",
          "use-cases/product-demos",
          "use-cases/lessons"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/how-it-works",
          "concepts/cues",
          "concepts/page-contract",
          "concepts/sound"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          {
            "group": "Write",
            "pages": [
              "guides/writing-for-the-ear",
              "guides/dialogue"
            ]
          },
          {
            "group": "Slides",
            "pages": [
              "guides/design-a-slide",
              "guides/slide-recipes",
              "guides/motion",
              "guides/page-by-hand"
            ]
          },
          {
            "group": "Sound and footage",
            "pages": [
              "guides/effects-on-a-cue",
              "guides/clip-section"
            ]
          },
          {
            "group": "Ship",
            "pages": [
              "guides/rebuild-one-section",
              "guides/accessible-video",
              "guides/ci-and-offline"
            ]
          }
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/script-md",
          "reference/decktalk-toml",
          "reference/cues-json",
          "reference/runtime",
          "reference/cli",
          "reference/configuration",
          "reference/verify",
          "reference/artifacts",
          "reference/python-api",
          "reference/stability",
          "reference/what-leaves-your-machine",
          "reference/trust",
          "reference/measured",
          "reference/glossary"
        ]
      },
      {
        "group": "Agents",
        "pages": [
          "reference/card",
          "agents/agents-md",
          "agents/json",
          "agents/skills",
          "agents/install"
        ]
      },
      {
        "group": "Design decisions",
        "pages": [
          "decisions/overview",
          "decisions/timing-from-the-spoken-words",
          "decisions/the-recorder-steps-the-clock",
          "decisions/the-six-stages",
          "decisions/the-provider-interface",
          "decisions/the-skills-contract",
          "decisions/no-compatibility-while-alpha"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/troubleshooting",
          "help/faq",
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "decktalk.ai",
        "href": "https://decktalk.ai"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/jacobcbeaudin/decktalk"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jacobcbeaudin/decktalk",
      "website": "https://decktalk.ai"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "DeckTalk",
      "twitter:card": "summary_large_image"
    },
    "indexing": "all"
  },
  "redirects": [
    {
      "source": "/concepts/pipeline",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/concepts/project-file",
      "destination": "/reference/decktalk-toml"
    },
    {
      "source": "/decisions/the-magenta-cover",
      "destination": "/decisions/the-recorder-steps-the-clock"
    }
  ]
}
