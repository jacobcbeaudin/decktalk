{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "DeckTalk",
  "description": "Narrated presentations, cut to the word.",
  "colors": {
    "primary": "#7a5000",
    "light": "#f2b441",
    "dark": "#7a5000"
  },
  "background": {
    "color": {
      "light": "#fbf7f1",
      "dark": "#15110e"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Instrument Serif",
      "weight": 400
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "eyebrows": "section",
    "latex": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "requirements",
          "guides/first-deck"
        ]
      },
      {
        "group": "Use cases",
        "pages": [
          "use-cases/technical-tutorials",
          "use-cases/product-demos",
          "use-cases/lessons"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/how-it-works",
          "concepts/cues",
          "concepts/page-contract",
          "concepts/sound"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/writing-for-the-ear",
          "guides/design-a-slide",
          "guides/slide-recipes",
          "guides/rebuild-one-section",
          "guides/clip-section",
          "guides/effects-on-a-cue",
          "guides/accessible-video",
          "guides/ci-and-offline",
          "guides/page-by-hand"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/verify",
          "reference/script-md",
          "reference/decktalk-toml",
          "reference/cues-json",
          "reference/runtime",
          "reference/configuration",
          "reference/artifacts",
          "reference/what-leaves-your-machine",
          "reference/python-api",
          "reference/glossary",
          {
            "group": "Error codes",
            "pages": [
              "reference/errors/INPUT",
              "reference/errors/NOT_BUILT",
              "reference/errors/PROVIDER",
              "reference/errors/TOOL",
              "reference/errors/LOCKED",
              "reference/errors/APPROVAL",
              "reference/errors/CANCELLED",
              "reference/errors/USAGE",
              "reference/errors/INTERNAL"
            ]
          },
          {
