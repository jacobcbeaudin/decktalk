# Copy to .env in your project directory (git-ignored). Never commit the real keys.
# ElevenLabs: `decktalk narrate` (TTS with word timestamps) and `decktalk soundscape` (sfx + music).
ELEVENLABS_API_KEY=<your-elevenlabs-key>
ELEVENLABS_VOICE_ID=<voice-id>
# Optional, only for `decktalk broll` (text-to-video). Either one; Gemini is preferred.
GEMINI_API_KEY=<optional-gemini-key>
FAL_KEY=<optional-fal-key>
