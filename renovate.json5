// Renovate keeps every pinned version in DeckTalk current: the locked Python, conda and Node packages,
// the SHA-pinned actions, the hook repositories, and the pins that only the custom managers below can read.
// Updates arrive once a week as one pull request per ecosystem. Nothing merges on its own: a person
// reads each pull request and its CI run before it merges.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Every action stays pinned by its full commit SHA, with the tag as a comment beside it. A tag can
    // move to other code after review, and a SHA cannot.
    'helpers:pinGitHubActionDigests',
    // The ecosystem pull requests move a range only when a release falls outside it. This weekly
    // refresh solves pixi.lock again and refreshes package-lock.json, so every locked package, direct
    // or transitive, moves inside its range.
    ':maintainLockFilesWeekly',
  ],
  // config:recommended makes a dependency bump fix(deps), and release-please cuts a release for every
  // fix. A dependency bump is build(deps), so it never cuts a release or writes a changelog line.
  ignorePresets: [':semanticPrefixFixDepsChoreOthers'],
  semanticCommits: 'enabled',
  semanticCommitType: 'build',
  semanticCommitScope: 'deps',
  timezone: 'America/Los_Angeles',
  // One run a week, before the work week starts, so a week of releases arrives as one set of pull requests.
  schedule: ['* 0-5 * * 1'],
  // Renovate reads the repository's Dependabot alerts and opens a fix at once, outside the schedule.
  // It is the one bot that writes security fixes, so each fix keeps the build(deps) type and the
  // release-please rule below. Dependabot alerts stay on, and Dependabot security updates stay off.
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['security'],
  },
  // Renovate turns this manager off by default. It moves the `rev:` of each hook repository. The local
  // hooks have no `rev:`: ruff, ty and prek move with pixi.lock, and Biome moves with package-lock.json.
  'pre-commit': {
    enabled: true,
  },
  packageRules: [
    // A release younger than three days can still be yanked or unpublished, and most bad releases are
    // found in that time.
    {
      matchDatasources: ['pypi', 'npm', 'conda'],
      minimumReleaseAge: '3 days',
    },

    // One pull request per ecosystem.
    {
      matchManagers: ['github-actions'],
      groupName: 'actions',
    },
    // The pep621 manager reads [project] and [dependency-groups] in pyproject.toml. Renovate reads no
    // locked version from pixi.lock, so the weekly lock refresh above moves each package inside its
    // range, and this group opens only for a release outside a range. update-lockfile keeps each floor
    // where it is: a floor rises only when DeckTalk needs a newer release, and its comment says why.
    {
      matchManagers: ['pep621'],
      groupName: 'python',
      rangeStrategy: 'update-lockfile',
    },
    // The pixi manager reads the [tool.pixi.*] tables in pyproject.toml: the conda-forge packages beside
    // each Python. It runs `pixi lock`, so pyproject.toml and pixi.lock change in one pull request. It
    // has no update-lockfile strategy, so it moves a range only when a release falls outside it.
    {
      matchManagers: ['pixi'],
      groupName: 'conda',
    },
    // esbuild and Biome are pinned by package-lock.json, because a lockfile is the only way to make the
    // byte-for-byte bundle check mean anything.
    {
      matchManagers: ['npm'],
      groupName: 'node',
    },
    {
      matchManagers: ['pre-commit'],
      groupName: 'pre-commit hooks',
    },
    // The pins the custom managers below read.
    {
      matchManagers: ['custom.regex'],
      groupName: 'pinned tools',
    },
    // The weekly lock refresh is one pull request for both lock files. The pep621 and pixi managers
    // both read pyproject.toml and would each solve pixi.lock again, so only the pixi manager does it.
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      groupName: 'lock files',
    },
    {
      matchManagers: ['pep621'],
      matchUpdateTypes: ['lockFileMaintenance'],
      enabled: false,
    },

    // Playwright is pinned to one minor, because the Python package and its Node driver must be one
    // release (see the comment beside the pin in pyproject.toml). When the next minor is out, pep621
    // raises both bounds in one pull request of its own, so a person confirms the conda-forge build
    // of that minor before it merges.
    {
      matchManagers: ['pep621'],
      matchPackageNames: ['playwright'],
      groupName: 'playwright',
    },
    // Pixi has two pins that must stay equal: `requires-pixi` in pyproject.toml, which Renovate's own
    // `pixi lock` also obeys, and the `pixi-version` of each setup-pixi step, which
    // tests/scripts/test_check.py holds to it. One group puts both in one pull request, so neither moves alone.
    {
      matchPackageNames: ['prefix-dev/pixi'],
      groupName: 'pixi',
    },

    // release-please is pinned to the version release-please-action bundles, so the next version the
    // rehearsal computes is the one the release computes. It moves by hand with the action's pin.
    {
      matchManagers: ['npm'],
      matchPackageNames: ['release-please'],
      enabled: false,
    },
    // Each Pixi environment pins one Python line, and CI runs one leg per line. A new line is a new
    // environment and a new leg, which a person adds by hand, so Renovate never moves a line.
    {
      matchManagers: ['pixi'],
      matchPackageNames: ['python'],
      enabled: false,
    },
    // nodejs is the floor package.json sets in `engines`, and `node --test` reads a directory differently
    // on Node 24 and later. A new major line is a different check, so it moves by hand with the floor.
    {
      matchManagers: ['pixi'],
      matchPackageNames: ['nodejs'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },

    // Each installer image carries a digest beside its tag, so a scenario judges install.sh and not the
    // image that was current on the day it ran. The digest moves weekly in the pinned tools pull request.
    {
      matchManagers: ['custom.regex'],
      matchDatasources: ['docker'],
      pinDigests: true,
    },
    // An image's tag names a distribution release the installer promises to support. A new release is a
    // line on the Dependency Dashboard, and a person decides when the installer supports it.
    {
      matchManagers: ['custom.regex'],
      matchDatasources: ['docker'],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      dependencyDashboardApproval: true,
    },
    // A new FFmpeg release is a line on the Dependency Dashboard, never a pull request on its own. The
    // build URLs and SHA-256 digests beside FFMPEG_VERSION change with it, and Renovate cannot compute
    // them: a person runs the fetch, reads the builds' notices, and writes the digests. An approval
    // opens a pull request that changes the version only, so add the digests to it before it merges.
    {
      matchPackageNames: ['FFmpeg/FFmpeg'],
      groupName: 'ffmpeg',
      dependencyDashboardApproval: true,
    },
  ],
  customManagers: [
    {
      // `requires-pixi`, the floor of the Pixi version. The pixi manager reads it as a constraint only
      // and never moves it, so this manager moves it on the same releases as setup-pixi's `pixi-version`.
      customType: 'regex',
      description: 'requires-pixi in pyproject.toml',
      managerFilePatterns: ['/^pyproject\\.toml$/'],
      matchStrings: ['requires-pixi\\s*=\\s*">=(?<currentValue>[^"]+)"'],
      depNameTemplate: 'pixi',
      packageNameTemplate: 'prefix-dev/pixi',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      // The bare images the installer scenarios run in, written as `image:tag@sha256:digest`. Docker
      // runs the digest and ignores the tag, and the tag tells a reader which release the digest is.
      customType: 'regex',
      description: 'in_image() images in scripts/check.py',
      managerFilePatterns: ['/^scripts/check\\.py$/'],
      matchStrings: [
        'in_image\\(\\s*"(?<depName>[a-z0-9./-]+):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
      autoReplaceStringTemplate: 'in_image("{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"',
    },
    {
      // The ffmpeg build `decktalk install` fetches. FFmpeg tags its releases n8.1.2, so the version is
      // the part after the n. See the packageRule above: this pin is a dashboard line only.
      customType: 'regex',
      description: 'FFMPEG_VERSION in the ffmpeg fetch',
      managerFilePatterns: ['/^src/decktalk/toolchain/ffmpeg_fetch\\.py$/'],
      matchStrings: ['FFMPEG_VERSION = "(?<currentValue>[^"]+)"'],
      depNameTemplate: 'FFmpeg/FFmpeg',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^n(?<version>\\d+\\.\\d+(?:\\.\\d+)?)$',
      versioningTemplate: 'loose',
    },
  ],
}
